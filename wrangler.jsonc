{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "balls-93fyi",
  "compatibility_date": "2026-10-01",
  // Static-only Worker: serves public/ as-is, no script.
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "balls.93.fyi", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
